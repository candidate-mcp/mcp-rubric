{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/api-proxy/[...path].ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api-proxy/:path*",
      "destination": "/api/api-proxy/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

